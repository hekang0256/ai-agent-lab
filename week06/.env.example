# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。

# week06 pgvector 数据库（docker compose up -d 启动，端口 5433）
DATABASE_URL=postgresql://lab:lab123@localhost:5433/ai_agent_lab_vector

# true = Embedding 走 Mock，离线演示 / 单元测试
LLM_USE_MOCK=false

# 真实 Embedding API（可选；未配置则回退 LLM_BASE_URL / LLM_API_KEY）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-v3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here

# 注意：真实模型维度与 Mock(256) 不同，换模型需重建 policy_docs 表与索引
