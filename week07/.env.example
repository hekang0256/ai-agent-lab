# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略。
LLM_USE_MOCK=false

# 生成模型（OpenAI 兼容 /chat/completions）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
# 默认 0；Kimi Code 的 kimi-for-coding 等模型若要求固定值，设为 1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=5
EVAL_DELAY_SECONDS=0.5

# Embedding 模型（OpenAI 兼容 /embeddings）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-v3
# v3/v4 可指定维度；1024 与本周 pgvector Schema 对齐。v3/v4 单批最多 10 条
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# pgvector（本周默认端口 5434）
RAG_DATABASE_URL=postgresql://lab:lab123@localhost:5434/ai_agent_lab_rag
