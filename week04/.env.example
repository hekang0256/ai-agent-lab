# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。
# 与 week02/week03 共用同一套 OpenAI 兼容配置。

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# true = 使用 MockLLM，离线演示 / 单元测试
LLM_USE_MOCK=false

# 多模态实验注意：
# - 图像提取需要把 LLM_MODEL 换成支持视觉的型号（如 qwen-vl-plus / gpt-4o-mini），
#   并将 LLM_BASE_URL / LLM_API_KEY 换成对应厂商的配置。
# - 音频输入的字段格式各家差异较大，请查阅厂商文档；本周以图像为主。
